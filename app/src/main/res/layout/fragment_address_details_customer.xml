<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".fragmnts.AddressDetailsCustomerFragment">

<LinearLayout
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content">


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/txtAddressGet"
        style="@style/text_Box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeErrorColor="@color/brightRed"
        app:counterMaxLength="50"
        app:endIconCheckable="true"
        app:errorEnabled="true"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:hintAnimationEnabled="true">

        <EditText
            android:id="@+id/addressET"
            style="@style/et_login_signup"
            android:hint="Address"
            android:textCursorDrawable="@null"
            android:fontFamily="@font/montserrat_regular"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="text"
            android:maxLength="50"
            android:outlineAmbientShadowColor="@color/blue_light" />

    </com.google.android.material.textfield.TextInputLayout>


    <!--                    <androidx.appcompat.widget.AppCompatSpinner-->
    <!--                        android:id="@+id/countrySpinner"-->
    <!--                        style="@style/SpinnerThemexx"-->
    <!--                        android:layout_width="match_parent"-->
    <!--                        android:layout_height="match_parent"-->
    <!--                        android:background="@android:color/transparent" />-->
    <!--android:layout_marginLeft="@dimen/_10sdp"-->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/text_Box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeErrorColor="@color/brightRed"
        app:counterMaxLength="50"
        app:endIconCheckable="true"
        app:errorEnabled="true"
        app:hintAnimationEnabled="true"
        app:hintTextColor="@color/colorPrimaryVariant">

        <EditText
            android:id="@+id/countrySpinner"
            style="@style/et_login_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Country"
            android:textCursorDrawable="@null"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="text"
            android:focusable="false"
            android:fontFamily="@font/montserrat_regular"
            android:maxLength="50"
            android:outlineAmbientShadowColor="@color/blue_light"
            android:paddingStart="@dimen/_15sdp" />


    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        style="@style/text_Box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeErrorColor="@color/brightRed"
        app:counterMaxLength="50"
        app:endIconCheckable="true"
        app:errorEnabled="true"
        app:hintAnimationEnabled="true"
        app:hintTextColor="@color/colorPrimaryVariant">

        <!-- <AutoCompleteTextView
             android:id="@+id/statesList"
             style="@style/et_login_signup"
             android:layout_width="match_parent"
             android:layout_height="@dimen/_38sdp"
             android:hint="State"
             android:focusable="false"
             android:importantForAutofill="noExcludeDescendants"
             android:fontFamily="@font/montserrat_regular"
             android:paddingStart="@dimen/_15sdp" />
-->

        <EditText
            android:id="@+id/statesList"
            style="@style/et_login_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textCursorDrawable="@null"
            android:hint="State"
            android:focusable="false" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:visibility="gone" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        style="@style/text_Box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeErrorColor="@color/brightRed"
        app:counterMaxLength="50"
        app:endIconCheckable="true"
        app:errorEnabled="true"
        app:hintAnimationEnabled="true"
        app:hintTextColor="@color/colorPrimaryVariant">

        <AutoCompleteTextView
            android:id="@+id/citiesList"
            style="@style/et_login_signup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:hint="City"
            android:focusable="false"
            android:importantForAutofill="noExcludeDescendants"
            android:fontFamily="@font/montserrat_regular"
            android:paddingStart="@dimen/_15sdp" />
        <!--android:layout_marginLeft="@dimen/_10sdp"-->
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/text_Box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/lightGrey"
        app:boxStrokeErrorColor="@color/brightRed"
        app:counterMaxLength="50"
        app:endIconCheckable="true"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:errorEnabled="true"
        app:hintAnimationEnabled="true">

        <EditText
            android:id="@+id/etPinCode"
            style="@style/et_login_signup"
            android:hint="Pincode"
            android:textCursorDrawable="@null"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="number"
            android:outlineAmbientShadowColor="@color/blue_light" />

    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/choose_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Is Multiple Owner Applicable?"
        android:fontFamily="@font/montserrat_medium"
        android:textColor="@color/black"

        android:textSize="16sp"
        android:layout_marginTop="24dp"
        />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/radio_yes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes"


            android:layout_marginEnd="16dp" />

        <RadioButton
            android:id="@+id/radio_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_20sdp"
            android:text="No"

            />

    </RadioGroup>

    <RelativeLayout
        android:id="@+id/gst_cust_business"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        >
        <TextView
            android:id="@+id/tvGST1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="start"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="GST Certificate"
            android:fontFamily="@font/montserrat_regular"
            />

        <ImageView
            android:id="@+id/gstIv1"
            android:layout_below="@+id/tvGST1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pdf"
            android:scaleType="fitXY"
            android:padding="@dimen/_6sdp"
            />

        <ImageView
            android:id="@+id/deleteGst1"
            android:layout_below="@+id/tvGST1"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="43dp"
            android:layout_marginEnd="3dp"
            android:src="@drawable/ic_delete"
            />

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/gst_ll"

        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/_7sdp"
        android:background="@drawable/rounded_dashed_border_vivamagenta_all">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_gst"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_23sdp"
            android:src="@drawable/tpp_upload_image"
            android:layout_gravity="center"
            style="@style/Style.App.circleImageView"
            />
        <TextView
            android:layout_below="@+id/gstUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_22sdp"

            android:text="Upload GST Certificate(Subline)"
            android:fontFamily="@font/montserrat_regular"
            />

    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_panCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        >
        <TextView
            android:id="@+id/TvPanCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="start"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Organisation's PAN Card"
            android:fontFamily="@font/montserrat_regular"
            />

        <ImageView
            android:id="@+id/panIv"
            android:layout_below="@+id/TvPanCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pdf"
            android:scaleType="fitXY"
            android:padding="@dimen/_6sdp"
            />

        <ImageView
            android:id="@+id/deletePan"
            android:layout_below="@+id/TvPanCard"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="43dp"
            android:layout_marginEnd="3dp"
            android:src="@drawable/ic_delete"
            />

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/ll_pan"

        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/_7sdp"
        android:background="@drawable/rounded_dashed_border_vivamagenta_all">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_pan"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_23sdp"
            android:src="@drawable/tpp_upload_image"
            android:layout_gravity="center"
            style="@style/Style.App.circleImageView"
            />
        <TextView
            android:layout_below="@+id/panUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_22sdp"
            android:text="Upload Organisation's PAN Card"
            android:fontFamily="@font/montserrat_regular"
            />

    </LinearLayout>
    <RelativeLayout
        android:id="@+id/gstCerRL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        >
        <TextView
            android:id="@+id/ad_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="start"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Additional Document (if any)"
            android:fontFamily="@font/montserrat_regular"
            />

        <ImageView
            android:id="@+id/ad_Iv"
            android:layout_below="@+id/ad_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pdf"
            android:scaleType="fitXY"
            android:padding="@dimen/_6sdp"
            />

        <ImageView
            android:id="@+id/deleteAdd"
            android:layout_below="@+id/ad_tv"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="43dp"
            android:layout_marginEnd="3dp"
            android:src="@drawable/ic_delete"
            />

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/add_document_ll"

        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/_7sdp"
        android:background="@drawable/rounded_dashed_border_vivamagenta_all">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/add_document_iv"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_23sdp"
            android:src="@drawable/tpp_upload_image"
            android:layout_gravity="center"
            style="@style/Style.App.circleImageView"
            />
        <TextView
            android:layout_below="@+id/add_document_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_22sdp"
            android:text="Additional Document (if any)"
            android:fontFamily="@font/montserrat_regular"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/btnFirstDone"
            style="@style/loginButton"
            android:layout_marginVertical="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/square_filled_black"
            android:fontFamily="@font/monsrt_bold"
            android:text="Continue"
            android:textColor="@color/white" />

    </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/loginProgressBar"
        layout="@layout/layout_progress_bar"
        />

</RelativeLayout>